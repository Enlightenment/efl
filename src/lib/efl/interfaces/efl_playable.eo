interface @beta Efl.Playable
{
   [[Reports what a media object can do: how long it runs, whether it can be
     played at all, and whether it can be seeked within.

     Implemented by objects presenting timed media -- animated images, vector
     animations, video -- so a caller can ask those three questions without
     knowing which kind of object it is holding. All three are read-only;
     playback itself is driven through @Efl.Player.
   ]]
   methods {
        @property length {
             [[Length of the media, in seconds.

               $0.0 when the object holds nothing playable, or when it cannot
               report a duration.
             ]]
             get {
             }
             values {
                  length: double; [[The length of the stream in seconds.]]
             }
        }
        @property playable {
             [[Whether the object holds media it is able to play at all.]]
             get {
             }
             values {
                  playable: bool; [[$true if the media can be played.]]
             }
        }
        @property seekable {
             [[Whether playback can be moved to an arbitrary position.

               When $false, @Efl.Player.playback_position cannot be relied upon
               to move playback.
             ]]
             get {
             }
             values {
                  seekable: bool; [[$true if seekable.]]
             }
        }
   }
}
