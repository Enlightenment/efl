collections {
   group {
      name: "test_group";

      parts {
         part {
            name: "swallow";
            type: SWALLOW;

            description {
               state: "default" 0.0;

               rel1 {
                  relative: 0.0 0.0;
               }
               rel2 {
                  relative: 1.0 1.0;
               }
            }
         }
      }
   }

   group {
      name: "test_alias_group";
      parts {
         part {
            name: "aliased";
            type: SWALLOW;

            description {
               state: "default" 0.0;
            }
         }
      }
   }

   group {
      name: "test_alias_group_again";
      parts {
         alias: "aliased" "real";

         part {
            name: "real";
            type: SWALLOW;

            description {
               state: "default" 0.0;
            }
         }
      }
   }
}
