function Fnptr_Text_Func {
   [[A callback returning a string. @since 1.66]]
   params {
      @in x: int; [[The argument.]]
   }
   return: string; [[The text.]]
};

function Fnptr_Int_Func {
   [[A callback taking and returning an int, whose parameter is named
     like a local of the generated C++ caller. @since 1.66]]
   params {
      @in fw: int; [[The argument.]]
   }
   return: int; [[The result.]]
};

function Fnptr_Twice_Func {
   [[Another callback type, so a method can take two different ones. Its
     parameter is named like the data parameter of the generated caller.
     @since 1.66]]
   params {
      @in cxx_call_data: int; [[The argument.]]
   }
   return: int; [[The result.]]
};

function Fnptr_Visit_Func {
   [[A callback taking an object and a string. @since 1.66]]
   params {
      @in obj: Fnptr; [[The object the callback is issued on.]]
      @in text: string; [[A string.]]
      @in n: int; [[An int.]]
   }
   return: int; [[The result.]]
};

function Fnptr_Format_Func {
   [[A callback shaped like Efl.Ui.Format_Func: it writes into a buffer of the
     caller's and reads a value the caller keeps. @since 1.66]]
   params {
      @in str: strbuf; [[The buffer to write into.]]
      @in value: const(any_value); [[The value to format.]]
   }
   return: bool; [[Whether it worked.]]
};

function Fnptr_Out_Func {
   [[A callback with an out parameter, which the C++ binding does not map. No
     method takes it: it is here so the generated header, which declares a
     wrapper for it that refuses to be used, is compiled with every test.
     @since 1.66]]
   params {
      @out r: int; [[The result.]]
   }
};

function Fnptr_Owned_Buffer_Func {
   [[A callback taking a strbuf it owns, which the C++ binding does not map
     either; here for the same reason. @since 1.66]]
   params {
      @in str: strbuf @move; [[The buffer, which the callback frees.]]
   }
};

class Fnptr extends Efl.Object {
   [[A class with methods taking function pointers. @since 1.66]]
   data: Fnptr_Data;
   methods {
      text {
         [[Calls $cb with $value and returns what it returned.

           The callback is freed through its free function before the
           method returns, unless it is $null. @since 1.66]]
         params {
            @in cb: Fnptr_Text_Func; [[Called with $value.]]
            @in value: int; [[The value to pass it.]]
         }
         return: string; [[The text $cb returned.]]
      }
      apply {
         [[Calls $first then $second with $value and adds what they return.

           The callbacks are freed through their free functions before the
           method returns, unless they are $null. @since 1.66]]
         params {
            @in first: Fnptr_Int_Func; [[Called first.]]
            @in second: Fnptr_Twice_Func; [[Called second.]]
            @in value: int; [[The value to pass them.]]
         }
         return: int; [[The sum of both results.]]
      }
      sum_lent {
         [[Adds up the ints of $l without freeing it. Returns -1 when $l is
           $null.]]
         params {
            @in l: iterator<int>; [[The ints, from where the iterator is.]]
         }
         return: int; [[The sum.]]
      }
      format {
         [[Calls $cb with a buffer and the int 42, and returns 1 when what $cb
           wrote into the buffer is "value 42", 0 when it is anything else
           and -1 when $cb failed.]]
         params {
            @in cb: Fnptr_Format_Func; [[Called with the buffer and the value.]]
         }
         return: int; [[1 when the buffer holds what is expected.]]
      }
      visit {
         [[Calls $cb on itself with a string and an int, and returns its result.]]
         params {
            @in cb: Fnptr_Visit_Func; [[Called with this object.]]
         }
         return: int; [[What $cb returned.]]
      }
      visit_on_destroy {
         [[Keeps $cb and calls it on itself, with "bye" and 0, from its
           destructor, then frees it.]]
         params {
            @in cb: Fnptr_Visit_Func; [[Called while this object is destroyed.]]
         }
      }
   }
   implements {
      Efl.Object.destructor;
   }
}
